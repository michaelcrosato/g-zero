{
  "name": "g-zero",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Offline magnetic hover racing: 100 rivals, original pixel art, Three.js r181 and Rapier 0.19.3.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "engineVersions": {
    "three": "0.181.0",
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "check": "node scripts/build.mjs --check && node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelcrosato/g-zero.git"
  }
}
